# ---------------------------------------------------------------------------
# papicture — environment
#
# The app runs with ZERO config: with no keys set, checkout falls back to a
# built-in mock PayRex page so you can click all the way through on Vercel.
# Add the keys below to flip payment to the real PayRex test-mode flow.
# ---------------------------------------------------------------------------

# PayRex test-mode secret key (sk_test_...). When set, /api/checkout creates a
# real PayRex hosted CheckoutSession instead of the local mock page.
# Get test keys at https://dashboard.payrexhq.com
PAYREX_SECRET_KEY=

# Optional: comma-separated payment methods to enable on the PayRex session.
# Defaults to: card,gcash,maya
PAYREX_PAYMENT_METHODS=card,gcash,maya

# Optional: turn on a real image model for the studio look (the AI attire seam
# in /api/generate). Off by default — generation is real photo + sharp cleanup.
USE_AI_STUDIO=0

# ---------------------------------------------------------------------------
# Studio AI — the real selfie -> studio portrait conversion (lib/studio)
# ---------------------------------------------------------------------------

# Provider used by /api/generate:
#   mock   — zero-key sharp cleanup (no real transformation)
#   gemini — Gemini 2.5 Flash Image ("nano banana"), via Google. Image output
#            now needs BILLING enabled (free tier is effectively 0 / 429s).
#   fal    — fal.ai (hosts nano-banana + Flux Kontext + Qwen-Edit). Comes with
#            ~$20 free signup credit (~500 images) — the free-to-start option.
STUDIO_PROVIDER=mock

# --- Gemini (Google) ---
# Key: https://aistudio.google.com/apikey . Enable billing on the key's Cloud
# project to use the image model. Paid tier does NOT train on your data; request
# Zero Data Retention (ZDR) for real user selfies.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- fal.ai ---
# Key: https://fal.ai/dashboard/keys ($20 free credit on signup).
FAL_KEY=
FAL_MODEL=fal-ai/nano-banana/edit
